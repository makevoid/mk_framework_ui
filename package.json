    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "morphdom": "^2.7.7",
    "pug": "^3.0.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  }
}
